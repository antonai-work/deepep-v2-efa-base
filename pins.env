# Canonical pins for this repo's Dockerfile. Bump via scripts/bump-pin.sh.
# Last updated: 2026-05-06
DEEPEP_FORK=https://github.com/dmvevents/DeepEP-1.git
DEEPEP_BRANCH=aws-efa-auto-qp-cap-v2
DEEPEP_SHA=146cc356aa00c39ac1590c05775e05b0f031e70c

# CUDA runtime (all cu12 to match torch cu129 + DeepEP + vllm _C.abi3.so).
# HISTORICAL: cu129 is a CUDA 12.9 build, NOT cu13. Mixing cu12 and cu13
# NCCL causes invalid-device-ordinal crashes at runtime (Wave 8 evidence).
NVIDIA_NCCL_PIN=nvidia-nccl-cu12>=2.30.4
