# Canonical pins for this repo's Dockerfile. Bump via scripts/bump-pin.sh.
# Last updated: 2026-05-06 (Wave 12: complete cu13 migration - torch cu130)
DEEPEP_FORK=https://github.com/dmvevents/DeepEP-1.git
DEEPEP_BRANCH=aws-efa-auto-qp-cap-v2
DEEPEP_SHA=146cc356aa00c39ac1590c05775e05b0f031e70c

# Wave 12: complete cu13 migration - torch also cu13 to match vllm._C.abi3.so
# Wave 11 proved NCCL cu13 alone (Wave 10's v0.2.0) is insufficient because
# torch cu129 runtime vs vllm cu13 runtime still produces libcudart TLS split
# (c10::cuda::SetDevice receiving -112 at MoE dispatch).
#
# Phase 1 availability check (2026-05-06):
#   - https://download.pytorch.org/whl/cu130/torch/ serves 2.11.0+cu130 stable
#   - torchvision 0.26.0+cu130 and torchaudio 2.11.0+cu130 are also present
#   - torch 2.11.0+cu130 wheel Requires-Dist pulls cuda-toolkit==13.0.2 which
#     provides nvidia-cuda-runtime==13.0.96 (libcudart.so.13), nvidia-cuda-nvcc
#     ==13.0.88 (nvcc 13), nvidia-nccl-cu13==2.28.9 (superseded by our
#     >=2.30.4 pin), and nvidia-nvshmem-cu13==3.4.5 - the full cu13 runtime
#     lands in site-packages automatically when torch is pip-installed.
#
# The cu13 wheel writes libcudart.so.13 into site-packages/nvidia/cuda_runtime/lib
# not /usr/local/cuda, so the Wave 10 "cu13 nvcc blocked" concern doesn't
# apply - torch.cpp_extension resolves nvcc via the wheel-provided path.
# Base OS stays on cu12.9-devel-ubuntu24.04 per plan guidance; cu13
# runtime libs come from pip wheels exclusively.
#
# NOTE: the value MUST be single-quoted because `>=` would otherwise
# be interpreted as shell redirection when pins.env is sourced
# (regression seen in a failed v0.1.2-sm90a GHA run).
NVIDIA_NCCL_PIN='nvidia-nccl-cu13>=2.30.4'

# PyTorch index URL. Wave 12: cu130 closes the Wave 10 partial migration.
TORCH_INDEX=https://download.pytorch.org/whl/cu130
